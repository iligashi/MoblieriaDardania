# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob (product image uploads)
BLOB_READ_WRITE_TOKEN=

# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://flux-dekor.com

# Optional: overrides the WhatsApp number in lib/shop-config.ts (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=38349514788
